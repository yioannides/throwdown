#: data/io.github.yioannides.Throwdown.metainfo.xml.in:8 src/gtk/window.blp:5
msgid "Throwdown"
msgstr "Throwdown"

#. TRANSLATORS: do NOT translate or localize the semicolons!
#: data/io.github.yioannides.Throwdown.desktop.in:9
msgid "skateboard;skate;trick;challenge;"
msgstr "σκέϊτμπορντ;σκέϊτ;κόλπο;πρόκληση;"

#: data/io.github.yioannides.Throwdown.gschema.xml:9 src/gtk/preferences.blp:11
msgid "Enable 360 Spins"
msgstr "Περιφορά 360 μοιρών"

#: data/io.github.yioannides.Throwdown.gschema.xml:10
msgid "Allow 360-degree spins when generating tricks."
msgstr "Να επιτρέπεται η περιφόρα 360 μοιρών στην παραγωγή κόλπων."

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:9
msgid "Improve your skateboarding skills!"
msgstr "Βελτίωσε τις ικανότητες σου στο σκέϊτμπορντινγκ!"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:11
msgid ""
"Throwdown is a minimal GNOME app for generating random skateboarding trick "
"sequences! Features include:"
msgstr ""
"Το Throwdown είναι μια εφαρμογή για το GNOME για να παράγεις τυχαίες "
"ακολουθείες κόλπων του σκέϊτμπορντ! Κάποια χαρακτηριστικά:"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:13
msgid "Three levels of difficulty (easy, medium, hard) and random mode"
msgstr "Τρία επίπεδα δυσκολίας (εύκολο, μέτριο, δύσκολο) και τυχαίο"

#. Translate as much as your language allows you to, but using the original words is not a problem either
#: data/io.github.yioannides.Throwdown.metainfo.xml.in:15
msgid ""
"Type of modules: stance, direction, spin, flip, grind, late flip and ground "
"tricks"
msgstr ""
"Τύποι δομοστοιχείων: στάση, πορεία, περιστροφή, flip, grind, late flip και "
"κόλπα εδάφους"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:16
msgid "Named tricks (example: Fakie BS 360 -> Full Cab)"
msgstr "Επώνυμα κόλπα (παράδειγμα: Fakie BS 360 -> Full Cab)"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:42
msgid "Main window"
msgstr "Κυρίως παράθυρο"

