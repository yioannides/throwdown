using Gtk 4.0;
using Adw 1;

template $PreferencesDialog : Adw.PreferencesDialog {
  Adw.PreferencesPage {

    Adw.PreferencesGroup behavior_group {
      title: _("Behavior");

      Adw.SwitchRow spin_360 {
        title: _("Enable 360 Spins");
        subtitle: _("Allow 360-degree spins when generating tricks");
      }
    }
  }
}